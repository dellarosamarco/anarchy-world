{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anarchy.world/schema/world.schema.json",
  "title": "AnarchyWorld document",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "route", "title", "canvas", "blocks"],
  "properties": {
    "version": { "const": 1 },
    "route": { "type": "string", "pattern": "^/(?:[a-z0-9-]+/)*[a-z0-9-]*$", "maxLength": 256 },
    "title": { "type": "string", "maxLength": 120 },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background"],
      "properties": {
        "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "blocks": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "base": {
      "type": "object",
      "required": ["id", "type", "x", "y", "width", "height"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "type": { "enum": ["text", "image", "link", "shape"] },
        "x": { "type": "number", "minimum": -10000, "maximum": 10000 },
        "y": { "type": "number", "minimum": -10000, "maximum": 10000 },
        "width": { "type": "number", "minimum": 1, "maximum": 5000 },
        "height": { "type": "number", "minimum": 1, "maximum": 5000 }
      }
    },
    "block": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/base" },
            {
              "type": "object",
              "properties": {
                "type": { "const": "text" },
                "content": { "type": "string", "maxLength": 10000 },
                "fontSize": { "type": "number", "minimum": 8, "maximum": 200 },
                "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
              },
              "required": ["content"]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/base" },
            {
              "type": "object",
              "properties": {
                "type": { "const": "image" },
                "src": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
                "alt": { "type": "string", "maxLength": 500 }
              },
              "required": ["src", "alt"]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/base" },
            {
              "type": "object",
              "properties": {
                "type": { "const": "link" },
                "label": { "type": "string", "maxLength": 200 },
                "href": { "type": "string", "pattern": "^(?:/|https://)", "maxLength": 2048 }
              },
              "required": ["label", "href"]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/base" },
            {
              "type": "object",
              "properties": {
                "type": { "const": "shape" },
                "shape": { "enum": ["rectangle", "circle"] },
                "fill": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
              },
              "required": ["shape", "fill"]
            }
          ],
          "unevaluatedProperties": false
        }
      ]
    }
  }
}
